# ============================================================================
# Docker 环境变量配置模板
# 使用方法: 复制此文件另存为 .env 并填写实际值
# 注意: .env 文件不应提交到版本控制系统
# ============================================================================

# ================================
# MySQL 数据库配置 (宿主机)
# ================================
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=demo1
MYSQL_USERNAME=user1
MYSQL_PASSWORD=your_secure_password_here

# ================================
# Redis 配置
# ================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ================================
# 应用配置
# ================================
SERVER_PORT=8080
TZ=Asia/Shanghai

# ================================
# JVM 配置
# ================================
# JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC
JAVA_OPTS=-Xms2g -Xmx2g -XX:+UseG1GC

# ================================
# SSL 证书配置 (可选)
# ================================
# 如果启用 HTTPS，请将证书文件放置在 ./ssl/ 目录下
# SSL_CERTIFICATE=fullchain.pem
# SSL_CERTIFICATE_KEY=privkey.pem

# ================================
# 域名配置
# ================================
DOMAIN_NAME=localhost
