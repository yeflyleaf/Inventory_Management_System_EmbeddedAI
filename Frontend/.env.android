# Android 环境 API 地址
# 注意：Android 模拟器或真机无法通过 localhost 访问电脑
# 必须使用电脑的局域网 IP 地址 (例如 192.168.x.x)

# --- 基础配置 ---
# 本地服务端
# VITE_SERVER_HOST=10.0.2.2
# VITE_SERVER_PORT=80

# window服务器
# VITE_SERVER_HOST=10.63.115.56
# VITE_SERVER_PORT=80

# 虚拟机服务端
VITE_SERVER_HOST=10.63.115.56
VITE_SERVER_PORT=18080

# --- 嵌套引用 (自动组合) ---
VITE_API_BASE_URL=http://${VITE_SERVER_HOST}:${VITE_SERVER_PORT}/api
