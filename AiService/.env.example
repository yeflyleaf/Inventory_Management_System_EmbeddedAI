# LLM API configuration defaults (will fallback to Java settings if database overrides exist)
OPENAI_API_KEY=demo
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_VECTOR_INDEX=item_index
REDIS_VECTOR_DIMENSION=384

# Java Backend communication configuration
JAVA_BACKEND_URL=http://localhost:8080
