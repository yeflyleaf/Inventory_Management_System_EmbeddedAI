# ============================================
# 进销存管理系统 - .gitignore
# ============================================

# ------------------------------------------
# General / OS / IDE
# ------------------------------------------
# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editor / IDE directories and files
.idea/
.vscode/
*.swp
*.swo
*.swn
*.suo
*.ntvs*
*.njsproj
*.sln
*.iml
*.sublime-workspace
*.sublime-project

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary files
tmp/
temp/

# ------------------------------------------
# Frontend (Vue3 + Vite + Electron)
# ------------------------------------------
# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
dist_electron/
build/
out/
coverage/
.nyc_output/

# Caches
.eslintcache
.cache
.parcel-cache
*.tsbuildinfo
.sass-cache/

# Testing
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ------------------------------------------
# Backend (Spring Boot + Maven)
# ------------------------------------------
# Maven
target/
dependency-reduced-pom.xml

# Eclipse
.classpath
.project
.settings/

# STS
.springBeans

# ------------------------------------------
# Mobile (Android / Capacitor)
# ------------------------------------------
# Android
Frontend/android/.gradle/
Frontend/android/local.properties
Frontend/android/*/build/
Frontend/android/build/
Frontend/android/app/build/
Frontend/android/captures/
Frontend/android/.idea/

# ------------------------------------------
# Environment Variables
# ------------------------------------------
.env
.env.local
.env.*.local
!.env.example
!.env.test

# ------------------------------------------
# Docker & Security
# ------------------------------------------
docker-data/
ssl/*.pem
ssl/*.key
ssl/*.crt
ssl/*.csr

# ------------------------------------------
# Misc / User Data
# ------------------------------------------
# Office files (Temporary or Binary)
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls
prompt.md

# Archives
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# User uploads
Backend/uploads/
uploads/
